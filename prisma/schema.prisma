// ─────────────────────────────────────────────────────────────
// Prevailing wage and certified payroll
// ─────────────────────────────────────────────────────────────

/// How a state charges workers compensation, which changes what goes in the
/// per-hour box on the wage sheet.
enum WorkersCompBasis {
  /// Premium quoted per hour worked, which the wage sheet takes directly.
  PER_HOUR
  /// Premium quoted per 100 dollars of payroll, the ordinary case. Divide by
  /// 100 and multiply by the hourly wage to get the per-hour figure.
  PER_100_PAYROLL
}

/// A state, or the District of Columbia, as far as payroll is concerned.
///
/// Holds only what genuinely varies by state. The federal rates are on the
/// company, because they do not vary by state and must not be stored twice.
///
/// The state unemployment rate is deliberately left empty until somebody fills
/// it in from the annual notice, because it is set per employer per year and no
/// list can be right for every company. `verifiedAt` records that somebody
/// checked it, and against what.
model PayrollJurisdiction {
  id        String  @id @default(cuid())
  companyId String
  /// Two-letter postal code, for example WA.
  code      String
  name      String

  /// Employer's state unemployment rate as a fraction. Null until verified.
  sutaPct       Float?
  /// Wages per employee per year the state unemployment rate applies to.
  /// Recorded for reference; the wage sheet charges every hour, see notes.
  sutaWageBase  Float?
  /// The year the rate above was issued for.
  sutaRateYear  Int?

  workersCompBasis WorkersCompBasis @default(PER_100_PAYROLL)
  /// True where workers compensation is bought from a state monopoly fund
  /// rather than on the private market.
  stateFund        Boolean          @default(false)

  /// Who publishes the prevailing wage determinations used here.
  wageAuthority    String?
  notes            String?

  verifiedAt   DateTime?
  verifiedById String?
  verifiedNote String?

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  verifiedBy User?                     @relation("PayrollJurisdictionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  counties   PayrollCounty[]
  sheets     WageRateSheet[]
  classifications LaborClassification[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// A county inside a state.
///
/// Prevailing wage is determined county by county, both federally and in the
/// states that publish their own schedules, so the county is what identifies
/// which schedule a sheet was built from.
model PayrollCounty {
  id             String @id @default(cuid())
  jurisdictionId String
  name           String
  /// Census FIPS code, where it is known, for matching published schedules.
  fips           String?

  /// Anything local: a city ordinance above the state rate, a separate
  /// determination area, a heavy and highway split.
  notes String?

  verifiedAt   DateTime?
  verifiedById String?

  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jurisdiction PayrollJurisdiction @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  verifiedBy   User?               @relation("PayrollCountyVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  sheets       WageRateSheet[]

  @@unique([jurisdictionId, name])
  @@index([jurisdictionId])
}

/// One certified payroll wage rate sheet for a project.
///
/// A project can carry more than one: work in two counties, or a schedule that
/// changed part way through, means two sheets rather than edited history.
model WageRateSheet {
  id             String  @id @default(cuid())
  projectId      String
  name           String
  jurisdictionId String
  countyId       String?

  /// The date of the determination or agreement the rates were taken from.
  rateScheduleDate DateTime?
  /// How to find that schedule again: a general decision number, an L&I
  /// effective date, a union agreement name.
  determinationRef String?

  /// State unemployment rate for this sheet, where it differs from the rate on
  /// the jurisdiction. Null means use the jurisdiction, which is the usual case.
  sutaPctOverride Float?

  verifiedAt   DateTime?
  verifiedById String?
  verifiedNote String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jurisdiction PayrollJurisdiction  @relation(fields: [jurisdictionId], references: [id], onDelete: Restrict)
  county       PayrollCounty?       @relation(fields: [countyId], references: [id], onDelete: SetNull)
  verifiedBy   User?                @relation("WageRateSheetVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  lines        WageRateLine[]

  @@unique([projectId, name])
  @@index([projectId])
}

/// One trade on a wage sheet. The seven boxes of the form, and nothing derived:
/// every subtotal, burden and total is computed from these on the way out.
model WageRateLine {
  id      String @id @default(cuid())
  sheetId String
  /// Trade and position as the schedule names it, for example "Carpenter,
  /// journey level".
  trade   String
  /// The schedule's own classification code, where it has one.
  classification String?

  /// Item 1, the cash wage per hour.
  hourlyWage     Float @default(0)
  /// Item 2, the bona fide fringe benefit per hour.
  hourlyBenefits Float @default(0)
  /// Item 6, training and education per hour.
  trainingPerHour     Float @default(0)
  /// Item 7, workers compensation per hour.
  workersCompPerHour  Float @default(0)
  /// 1.5 for time and a half, 2 for double time.
  overtimeMultiplier  Float @default(1.5)

  /// The published determination, for checking this row against it. Optional,
  /// because a sheet built from a union agreement has no separate published
  /// figure to check against.
  publishedBaseWage Float?
  publishedFringe   Float?

  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sheet WageRateSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@unique([sheetId, trade])
  @@index([sheetId])
}

// ─────────────────────────────────────────────────────────────
// Labor cost, project team and overhead
// ─────────────────────────────────────────────────────────────

enum PayBasis {
  /// Paid by the hour. Amounts on the classification are per hour.
  HOURLY
  /// Paid a salary. Amounts on the classification are per year.
  SALARY
}

enum LaborKind {
  /// Craft labor, priced into takeoff lines and charged to a work code.
  FIELD
  /// Project team and office: managers, superintendents, engineers,
  /// estimators, administration. Charged to general conditions or carried
  /// as overhead when not on a job.
  STAFF
}

enum AssignmentBasis {
  /// A number of hours at the loaded hourly cost.
  HOURS
  /// A share of somebody's time across a date range.
  ALLOCATION
}

/**
 * What one classification of person costs the company, fully loaded.
 *
 * The single place a wage or a salary is entered. Estimates price takeoff
 * labor through it, projects assign people to jobs through it, and the
 * overhead recovery rate counts the staff who are not on a job through it, so
 * a pay rise is entered once and every one of those moves.
 *
 * Amounts are per hour when paid hourly and per year when salaried, which is
 * how each is actually quoted. `annualHours` is how a salary is spread onto an
 * hour, and it is deliberately not fixed at 2080: a superintendent who works
 * 2400 hours costs less an hour than the same salary spread over 2080, and
 * pricing at the wrong one is how general conditions quietly go light.
 */
model LaborClassification {
  id        String @id @default(cuid())
  companyId String
  /// The company's own code for this classification, where it has one.
  code      String?
  name      String
  kind      LaborKind @default(FIELD)
  payBasis  PayBasis  @default(HOURLY)

  /// Per hour when paid hourly, per year when salaried.
  baseAmount     Float @default(0)
  /// Fringe benefits. Per hour when paid hourly, per year when salaried.
  benefitsAmount Float @default(0)
  /// Hours a year a salary is spread over. Ignored when paid hourly.
  annualHours    Float @default(2080)

  /// Training and education, dollars per hour worked.
  trainingPerHour Float @default(0)
  /// Workers compensation for this classification's risk class, quoted the way
  /// the jurisdiction quotes it: per hour worked, or per 100 dollars of payroll.
  workersCompRate Float @default(0)

  /// Whose state unemployment rate applies. Null uses no state rate, and the
  /// classification says so rather than pricing labor light in silence.
  jurisdictionId String?

  /// Where this person's cost lands in a budget.
  costCategory CostCategory @default(LABOR)
  tradeId      String?

  notes     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jurisdiction PayrollJurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  trade        Trade?               @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  assignments  ProjectLaborAssignment[]
  estimateRates LaborRate[]

  @@unique([companyId, name])
  @@index([companyId])
}

/**
 * A person or a classification charged to a project.
 *
 * Two ways to say it, because two things are being said. Craft labor and short
 * stints are a number of hours. A salaried manager is a share of somebody's
 * time across a range of dates, which is how project teams are actually
 * staffed: half a project manager from March to November, a superintendent
 * full time for the duration, an estimator for the three weeks of the bid.
 *
 * The cost is never stored. It is derived from the classification's loaded
 * rate every time it is read, so a pay rise reprices every job that person is
 * on rather than leaving a set of stale numbers behind.
 */
model ProjectLaborAssignment {
  id               String @id @default(cuid())
  projectId        String
  classificationId String
  /// The person, when this is a named person rather than a generic role.
  label            String?
  /// Where the cost lands. Null falls back to the classification's cost type.
  costCodeId       String?

  basis AssignmentBasis @default(ALLOCATION)

  /// Hours basis.
  budgetedHours Float @default(0)

  /// Allocation basis: the share of their time, and over what dates.
  allocationPct Float     @default(1)
  startDate     DateTime?
  endDate       DateTime?

  /// A rate negotiated for this job specifically. Null is the ordinary case
  /// and the classification's own loaded rate is used.
  loadedRateOverride Float?

  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  classification LaborClassification @relation(fields: [classificationId], references: [id], onDelete: Restrict)
  costCode       CostCode?           @relation(fields: [costCodeId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([classificationId])
}

enum OverheadCategory {
  OFFICE
  VEHICLES
  SOFTWARE
  INSURANCE
  EQUIPMENT
  PROFESSIONAL
  MARKETING
  TRAINING
  OTHER
}

enum OverheadPeriod {
  MONTHLY
  ANNUAL
  ONE_TIME
}

/**
 * A cost of being in business that no single job pays for directly.
 *
 * Rent, trucks, software, insurance, professional fees. Held so the overhead
 * percentage carried in a bid can be worked out from what the company actually
 * spends rather than guessed, and so an estimator pricing a trailer or a
 * software seat into general conditions can see what the real one costs.
 *
 * Salaried staff are deliberately not entered here. They are already on the
 * classification list, and the overhead summary counts the share of them that
 * no project is paying for. Entering a salary in both places would be the same
 * money twice.
 */
model OverheadCost {
  id        String           @id @default(cuid())
  companyId String
  name      String
  category  OverheadCategory @default(OTHER)
  amount    Float            @default(0)
  period    OverheadPeriod   @default(MONTHLY)
  /// When a one-time cost fell, or when an annual item renews.
  incurredOn DateTime?

  notes     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────
// Labor compliance
// ─────────────────────────────────────────────────────────────

enum ComplianceKind {
  CERTIFIED_PAYROLL
  PREVAILING_WAGE_POSTING
  FRINGE_BENEFIT_STATEMENT
  APPRENTICESHIP_UTILIZATION
  EEO_REPORT
  WAGE_DETERMINATION_UPDATE
  INTENT_OR_AFFIDAVIT
  OSHA_LOG
  INSURANCE_CERTIFICATE
  LICENSE_OR_REGISTRATION
  OTHER
}

enum ComplianceFrequency {
  WEEKLY
  BIWEEKLY
  SEMIMONTHLY
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

/**
 * Something this job has to file, and how often.
 *
 * Certified payroll every week, an apprenticeship utilisation report every
 * month, a wage determination checked each quarter. The point is the deadline:
 * a missed certified payroll can stop a payment application, and nobody
 * remembers a weekly filing on a job they did not open this week.
 *
 * The next due date is never stored. It is derived from the frequency, the
 * first due date and what has actually been filed, so it cannot go stale and
 * a late filing does not silently reset the schedule.
 */
model ComplianceRequirement {
  id        String              @id @default(cuid())
  projectId String
  kind      ComplianceKind      @default(CERTIFIED_PAYROLL)
  title     String
  /// Who it goes to.
  agency    String?
  frequency ComplianceFrequency @default(WEEKLY)
  /// The first deadline. Every later one is counted forward from it.
  firstDueDate DateTime
  /// The last deadline, where the obligation ends before the job does.
  endsOn       DateTime?
  /// How many days ahead of a deadline to start warning.
  leadDays     Int @default(7)

  responsibleUserId String?

  notes     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responsible User?                  @relation("ComplianceOwner", fields: [responsibleUserId], references: [id], onDelete: SetNull)
  submissions ComplianceSubmission[]

  @@unique([projectId, title])
  @@index([projectId])
}

/// One filing actually made, against the deadline it was made for.
model ComplianceSubmission {
  id            String @id @default(cuid())
  requirementId String
  /// The deadline this filing answers.
  dueDate       DateTime
  /// The period the filing covers, where that differs from the deadline.
  periodEnd     DateTime?
  submittedAt   DateTime
  submittedById String?
  /// Confirmation number, file name, whatever proves it went.
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())

  requirement ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  submittedBy User?                 @relation("ComplianceSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)

  @@unique([requirementId, dueDate])
  @@index([requirementId])
}
