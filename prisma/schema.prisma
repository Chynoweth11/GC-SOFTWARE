// ConstructX, construction financial operating system
// Single source of truth for estimating, budgets, commitments, job cost,
// forecasting, billing and company-level financial rollups.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────
// Tenancy, identity and audit
// ─────────────────────────────────────────────────────────────

model Company {
  id                     String   @id @default(cuid())
  name                   String
  legalName              String?
  address                String?
  city                   String?
  state                  String?
  phone                  String?
  fiscalYearStartMonth   Int      @default(1)
  targetMarginPct        Float    @default(0.16)
  defaultRetentionPct    Float    @default(0.05)
  defaultLaborBurdenPct  Float    @default(0.34)
  defaultOverheadPct     Float    @default(0.06)
  /// Federal unemployment, employer share, on the wage. The net 0.6 percent a
  /// state in good standing pays after the credit against the 6.0 percent rate.
  /// Federal, so it lives here once rather than on every state.
  futaPct                Float    @default(0.006)
  /// Social security and Medicare, employer share: 6.2 plus 1.45 percent.
  ficaPct                Float    @default(0.0765)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users          User[]
  projects       Project[]
  clients        Client[]
  vendors        Vendor[]
  costCodes      CostCode[]
  trades         Trade[]
  divisions      CsiDivision[]
  bids           Bid[]
  estimates      Estimate[]
  monthlyActuals CompanyMonthly[]
  arAging        ArAgingBucket[]
  auditLogs      AuditLog[]
  savedViews     SavedView[]
  vendorStates   VendorState[]
  vendorRegions  VendorRegion[]
  payrollJurisdictions PayrollJurisdiction[]
  laborClassifications LaborClassification[]
  overheadCosts        OverheadCost[]
}

enum Role {
  OWNER
  ADMIN
  EXECUTIVE
  PROJECT_MANAGER
  PROJECT_ENGINEER
  ESTIMATOR
  ACCOUNTING
  FINANCE
  READ_ONLY
}

model User {
  id           String    @id @default(cuid())
  companyId    String
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(READ_ONLY)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions        Session[]
  managedProjects Project[] @relation("ProjectManager")
  auditLogs       AuditLog[]
  savedViews      SavedView[]
  preferences     UserPreference[]

  verifiedJurisdictions PayrollJurisdiction[] @relation("PayrollJurisdictionVerifier")
  verifiedCounties      PayrollCounty[]       @relation("PayrollCountyVerifier")
  verifiedWageSheets    WageRateSheet[]       @relation("WageRateSheetVerifier")
  complianceOwned       ComplianceRequirement[] @relation("ComplianceOwner")
  complianceSubmitted   ComplianceSubmission[]  @relation("ComplianceSubmitter")

  @@index([companyId])
}

/// A named filter combination on the dashboard or a report.
/// Stores the query string only. The figures are always recomputed, so a saved
/// view can never serve a stale number.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  /// "dashboard" or the report slug the view belongs to.
  scope     String
  name      String
  query     String
  /// Loaded automatically when the user opens this scope.
  isDefault Boolean  @default(false)
  /// Visible to everyone in the company rather than just its author.
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, name])
  @@index([companyId, scope])
}

/// Per-user interface state: which dashboard tiles are shown and in what order.
/// Interface preference only; never a financial value.
model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// The permanent record of every change made in the system.
///
/// Append only. Database triggers reject UPDATE and DELETE on this table, so
/// the history cannot be rewritten by the application, by a migration, or by
/// anyone with a database console. Administrators read it; nobody edits it.
///
/// The author and the record's name are copied in rather than joined, because a
/// history that says "user deleted" instead of naming who made the change is not
/// a history worth keeping.
model AuditLog {
  id          String   @id @default(cuid())
  companyId   String
  userId      String?
  /// Who made the change, kept even if the user record is later removed.
  userName    String?
  userEmail   String?
  userRole    String?
  entity      String
  entityId    String
  /// What the record was called at the time, so the entry still reads plainly
  /// after the record itself has been deleted.
  entityLabel String?
  action      String
  field       String?
  oldValue    String?
  newValue    String?
  summary     String?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, entity, entityId])
  @@index([companyId, createdAt])
  @@index([companyId, userId])
  @@index([companyId, action])
}

// ─────────────────────────────────────────────────────────────
// Reference data: divisions, trades, cost codes
// ─────────────────────────────────────────────────────────────

enum CostCategory {
  LABOR
  MATERIAL
  EQUIPMENT
  SUBCONTRACT
  GENERAL_CONDITIONS
  OVERHEAD
  CONTINGENCY
  OTHER
}

model CsiDivision {
  id        String @id @default(cuid())
  companyId String
  code      String
  name      String
  sortOrder Int    @default(0)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trades        Trade[]
  costCodes     CostCode[]
  estimateItems EstimateItem[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Trade {
  id         String  @id @default(cuid())
  companyId  String
  name       String
  divisionId String?
  sortOrder  Int     @default(0)
  active     Boolean @default(true)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  division     CsiDivision?  @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  costCodes    CostCode[]
  budgetLines  BudgetLine[]
  changeOrders ChangeOrder[]
  bidPackages  BidPackage[]
  vendors      Vendor[]
  laborClassifications LaborClassification[]

  @@unique([companyId, name])
  @@index([companyId])
}

model CostCode {
  id          String       @id @default(cuid())
  companyId   String
  code        String
  description String
  category    CostCategory
  divisionId  String?
  tradeId     String?
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  division        CsiDivision?      @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  trade           Trade?            @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  budgetLines     BudgetLine[]
  commitmentLines CommitmentLine[]
  costTx          CostTransaction[]
  changeOrderLine ChangeOrderLine[]
  forecastLines   ForecastLine[]
  sovLines        SovLine[]
  quantityItems   QuantityItem[]
  subInvoices     SubInvoice[]
  laborAssignments ProjectLaborAssignment[]

  @@unique([companyId, code])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────
// Clients and vendors
// ─────────────────────────────────────────────────────────────

enum ClientType {
  RESIDENTIAL
  COMMERCIAL
  PUBLIC
  DEVELOPER
  INSTITUTIONAL
  OTHER
}

model Client {
  id        String      @id @default(cuid())
  companyId String
  name      String
  type      ClientType  @default(OTHER)
  /// Archived clients stay on their historic projects but are hidden from
  /// pickers. A client with history is archived rather than deleted, because
  /// removing it would orphan the projects that reference it.
  active    Boolean     @default(true)
  contact   String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime    @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]
  bids     Bid[]

  @@index([companyId])
}

/// A state a vendor can work in. Regions hang off it.
model VendorState {
  id        String   @id @default(cuid())
  companyId String
  name      String
  /// Two-letter abbreviation, used in compact tables.
  code      String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  regions VendorRegion[]
  vendors Vendor[]

  @@unique([companyId, name])
  @@index([companyId])
}

/// A working area inside a state, for example Tri-Cities or Denver Metro.
/// Fully user-defined so each company can name its own patch.
model VendorRegion {
  id        String   @id @default(cuid())
  companyId String
  stateId   String
  name      String
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  state   VendorState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  vendors Vendor[]

  @@unique([stateId, name])
  @@index([companyId])
}

model Vendor {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  active           Boolean  @default(true)
  isSubcontractor  Boolean  @default(true)
  /// Where this vendor works. Both are optional so a vendor is never blocked
  /// from being created before its area is known.
  stateId          String?
  regionId         String?
  tradeId          String?
  contactName      String?
  phone            String?
  email            String?
  address          String?
  taxId            String?
  w9OnFile         Boolean  @default(false)
  glExpiration     DateTime?
  wcExpiration     DateTime?
  autoExpiration   DateTime?
  umbrellaExpiration DateTime?
  bondRequired     Boolean  @default(false)
  bondStatus       String?
  paymentHold      Boolean  @default(false)
  paymentHoldReason String?
  performanceRating Float?
  safetyRating      Float?
  qualityRating     Float?
  scheduleRating    Float?
  notes            String?
  createdAt        DateTime @default(now())

  state       VendorState?     @relation(fields: [stateId], references: [id], onDelete: SetNull)
  region      VendorRegion?    @relation(fields: [regionId], references: [id], onDelete: SetNull)
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trade       Trade?           @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  commitments Commitment[]
  costTx      CostTransaction[]
  invoices    SubInvoice[]
  quotes      BidPackageQuote[]
  awarded     BidPackage[]     @relation("AwardedVendor")

  @@unique([companyId, name])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────
// Bid pipeline (CRM for opportunities)
// ─────────────────────────────────────────────────────────────

enum BidStatus {
  LEAD
  QUALIFYING
  ESTIMATING
  SUBMITTED
  PENDING_DECISION
  ON_HOLD
  WON
  LOST
  NO_BID
  WITHDRAWN
}

model Bid {
  id             String    @id @default(cuid())
  companyId      String
  number         String
  name           String
  clientId       String?
  clientContact  String?
  clientPhone    String?
  clientType     ClientType @default(OTHER)
  leadSource     String?
  location       String?
  estimator      String?
  dateReceived   DateTime?
  bidDue         DateTime?
  estimatedValue Float     @default(0)
  submittedAmount Float    @default(0)
  dateSubmitted  DateTime?
  status         BidStatus @default(LEAD)
  winProbability Float     @default(0)
  lastContact    DateTime?
  nextFollowUp   DateTime?
  touches        Int       @default(0)
  nextAction     String?
  decisionDate   DateTime?
  outcomeReason  String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  estimates Estimate[]
  projects  Project[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

// ─────────────────────────────────────────────────────────────
// Estimating and quantity takeoff
// ─────────────────────────────────────────────────────────────

enum EstimateStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  SUBMITTED
  AWARDED
  LOST
  ARCHIVED
}

model Estimate {
  id             String         @id @default(cuid())
  companyId      String
  bidId          String?
  name           String
  version        Int            @default(1)
  status         EstimateStatus @default(DRAFT)
  clientName     String?
  architect      String?
  address        String?
  projectType    String?
  bidDueDate     DateTime?
  estimator      String?
  drawingSet     String?
  addenda        String?
  durationWeeks  Float          @default(0)
  buildingAreaSf Float          @default(0)

  // factors
  laborBurdenPct Float @default(0.34)
  salesTaxPct    Float @default(0.086)
  smallToolsPct  Float @default(0.03)

  // markup chain, applied in order
  contingencyPct Float @default(0.03)
  overheadPct    Float @default(0.06)
  profitPct      Float @default(0.10)
  glInsurancePct Float @default(0.012)
  bondPct        Float @default(0.01)
  exciseTaxPct   Float @default(0.005)
  roundToNearest Float @default(500)

  lockedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company        Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bid            Bid?                  @relation(fields: [bidId], references: [id], onDelete: SetNull)
  laborRates     LaborRate[]
  sections       EstimateSection[]
  items          EstimateItem[]
  gcItems        GeneralConditionItem[]
  alternates     EstimateAlternate[]
  clarifications EstimateClarification[]
  bidPackages    BidPackage[]
  projects       Project[]

  @@index([companyId, status])
}

/**
 * A labor class priced on one estimate.
 *
 * Normally a pointer at the company's classification library, so a rate entered
 * once prices every estimate that uses it and a pay rise does not have to be
 * chased through open bids. `rate` is then null and the loaded rate is derived.
 *
 * A rate may still be typed in directly, for a class the library does not carry
 * or a number agreed for this bid alone. Exactly one of the two is ever set,
 * and the estimate says which it is reading.
 */
model LaborRate {
  id               String @id @default(cuid())
  estimateId       String
  className        String
  /// A rate entered for this estimate alone. Null when a classification is linked.
  rate             Float?
  classificationId String?
  sortOrder        Int    @default(0)

  estimate       Estimate             @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  classification LaborClassification? @relation(fields: [classificationId], references: [id], onDelete: SetNull)

  @@unique([estimateId, className])
}

model EstimateSection {
  id         String @id @default(cuid())
  estimateId String
  name       String
  sortOrder  Int    @default(0)

  estimate Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  items    EstimateItem[]

  @@index([estimateId])
}

enum MeasureType {
  EA
  LF
  SF
  SY
  CY
  CF
  TON
  LB
  HR
  DAY
  LS
  ALLOWANCE
}

model EstimateItem {
  id          String  @id @default(cuid())
  estimateId  String
  sectionId   String?
  divisionId  String?
  description String
  drawingRef  String?
  measure     MeasureType @default(EA)
  count       Float   @default(0)
  length      Float   @default(0)
  width       Float   @default(0)
  depth       Float   @default(0)
  /// Optional override of the derived quantity; null means derive from dimensions
  netQtyOverride Float?
  uom         String?
  wastePct    Float   @default(0)
  laborClass  String?
  laborHrsPerUnit Float @default(0)
  laborRateOverride Float?
  materialUnitCost  Float @default(0)
  equipmentUnitCost Float @default(0)
  subUnitCost       Float @default(0)
  notes       String?
  sortOrder   Int     @default(0)

  estimate Estimate         @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  section  EstimateSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  division CsiDivision?     @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  @@index([estimateId])
}

model GeneralConditionItem {
  id         String @id @default(cuid())
  estimateId String
  item       String
  basis      String @default("LS")
  qty        Float  @default(0)
  /// When true, qty follows the estimate duration in weeks
  followsDuration Boolean @default(false)
  unitCost   Float  @default(0)
  notes      String?
  sortOrder  Int    @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

model EstimateAlternate {
  id          String @id @default(cuid())
  estimateId  String
  number      String
  description String
  amount      Float  @default(0)
  accepted    Boolean @default(false)
  sortOrder   Int    @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

model EstimateClarification {
  id         String @id @default(cuid())
  estimateId String
  text       String
  sortOrder  Int    @default(0)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

// ─────────────────────────────────────────────────────────────
// Bid leveling / buyout (shared by estimates and awarded projects)
// ─────────────────────────────────────────────────────────────

enum BuyoutStatus {
  BIDDING
  LEVELED
  AWARDED
  BOUGHT_OUT
}

model BidPackage {
  id          String       @id @default(cuid())
  estimateId  String?
  projectId   String?
  tradeId     String?
  name        String
  divisionCode String?
  budgetAmount Float       @default(0)
  /// Amount carried in the estimate/budget before buyout
  carriedAmount Float      @default(0)
  awardedVendorId String?
  awardAmount  Float       @default(0)
  status       BuyoutStatus @default(BIDDING)
  notes        String?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())

  estimate      Estimate?         @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  trade         Trade?            @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  awardedVendor Vendor?           @relation("AwardedVendor", fields: [awardedVendorId], references: [id], onDelete: SetNull)
  quotes        BidPackageQuote[]

  @@index([estimateId])
  @@index([projectId])
}

enum QuoteStatus {
  PENDING
  RECEIVED
  DECLINED
  NO_BID
}

model BidPackageQuote {
  id           String      @id @default(cuid())
  packageId    String
  vendorId     String?
  vendorName   String
  baseAmount   Float       @default(0)
  adjustmentAmount Float   @default(0)
  inclusions   String?
  exclusions   String?
  qualifications String?
  allowances   Float       @default(0)
  status       QuoteStatus @default(PENDING)
  notes        String?
  sortOrder    Int         @default(0)

  package BidPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  vendor  Vendor?    @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@index([packageId])
}

// ─────────────────────────────────────────────────────────────
// Projects
// ─────────────────────────────────────────────────────────────

enum ProjectStatus {
  BIDDING
  AWARDED
  PRECONSTRUCTION
  UNDER_CONSTRUCTION
  ACTIVE
  ON_HOLD
  COMPLETED
  CLOSED
}

enum EacMethod {
  BOTTOM_UP
  CPI_BASED
  BUDGET_RATE
}

enum PocMethod {
  COST_TO_COST
  QUANTITY
  SUBCONTRACTOR_PROGRESS
  SCHEDULE
  MANUAL
  EARNED_VALUE
  BILLING
}

model Project {
  id                 String        @id @default(cuid())
  companyId          String
  number             String
  name               String
  clientId           String?
  address            String?
  city               String?
  state              String?
  projectType        String?
  deliveryMethod     String?
  architect          String?
  pmUserId           String?
  superintendent     String?
  status             ProjectStatus @default(ACTIVE)

  noticeToProceed    DateTime?
  contractStart      DateTime?
  contractCompletion DateTime?
  forecastCompletion DateTime?
  dataDate           DateTime?

  originalContractSum   Float @default(0)
  ownerRetentionPct     Float @default(0.05)
  defaultSubRetentionPct Float @default(0.05)
  targetMarginPct       Float @default(0.18)
  laborBurdenPct        Float @default(0.34)
  overheadPct           Float @default(0.06)
  workDaysPerWeek       Int   @default(5)

  eacMethod EacMethod @default(BOTTOM_UP)
  pocMethod PocMethod @default(COST_TO_COST)
  /// Fraction 0-1 used when pocMethod is MANUAL
  manualPctComplete Float?
  /// Fraction of pending change orders included in forecast
  pendingCoInclusionPct Float @default(0)

  safetyScore        Float?
  qualityScore       Float?
  clientSatScore     Float?
  recordablesYtd     Int    @default(0)
  nearMissesYtd      Int    @default(0)
  observationsYtd    Int    @default(0)

  sourceEstimateId String?
  sourceBidId      String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  pm             User?             @relation("ProjectManager", fields: [pmUserId], references: [id], onDelete: SetNull)
  sourceEstimate Estimate?         @relation(fields: [sourceEstimateId], references: [id], onDelete: SetNull)
  sourceBid      Bid?              @relation(fields: [sourceBidId], references: [id], onDelete: SetNull)

  budgetLines    BudgetLine[]
  revisions      BudgetRevision[]
  commitments    Commitment[]
  costTx         CostTransaction[]
  changeOrders   ChangeOrder[]
  sovLines       SovLine[]
  ownerBillings  OwnerBilling[]
  subInvoices    SubInvoice[]
  forecastPeriods ForecastPeriod[]
  cashFlowPeriods CashFlowPeriod[]
  quantityItems  QuantityItem[]
  snapshots      ProjectSnapshot[]
  bidPackages    BidPackage[]
  wageRateSheets WageRateSheet[]
  laborAssignments ProjectLaborAssignment[]
  complianceRequirements ComplianceRequirement[]

  @@unique([companyId, number])
  @@index([companyId, status])
}

// ─────────────────────────────────────────────────────────────
// Budget
// ─────────────────────────────────────────────────────────────

model BudgetLine {
  id             String       @id @default(cuid())
  projectId      String
  costCodeId     String
  description    String
  category       CostCategory
  tradeId        String?
  originalBudget Float        @default(0)
  notes          String?
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costCode  CostCode         @relation(fields: [costCodeId], references: [id], onDelete: Restrict)
  trade     Trade?           @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  revisions BudgetRevision[]

  @@unique([projectId, costCodeId])
  @@index([projectId])
}

enum BudgetRevisionType {
  CHANGE_ORDER
  TRANSFER
  REVISION
  CONTINGENCY_DRAW
}

model BudgetRevision {
  id            String             @id @default(cuid())
  projectId     String
  budgetLineId  String
  type          BudgetRevisionType
  amount        Float
  reason        String
  changeOrderId String?
  /// Paired transfer id so a transfer's two halves stay linked
  transferGroup String?
  createdBy     String?
  createdAt     DateTime           @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine  BudgetLine   @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([budgetLineId])
}

