{
  "name": "gc-software",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "setup": "node scripts/ensure-db.mjs",
    "predev": "node scripts/ensure-db.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-db.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:postgres-schema": "node scripts/postgres-schema.mjs",
    "verify:figures": "NODE_OPTIONS=--conditions=react-server tsx scripts/dev/verify-figures.ts",
    "verify:exports": "NODE_OPTIONS=--conditions=react-server tsx scripts/dev/verify-exports.ts",
    "verify:audit": "tsx scripts/dev/verify-audit-immutability.ts",
    "verify:backup": "NODE_OPTIONS=--conditions=react-server tsx scripts/dev/verify-backup.ts",
    "verify:pages": "node scripts/dev/walk.mjs",
    "verify:ui": "node scripts/dev/exercise.mjs",
    "verify": "npm run test && npm run verify:figures && npm run verify:exports && npm run verify:audit && npm run verify:backup"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "next": "16.2.12",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "optionalDependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "pg": "^8.23.0"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "nanoid": "^3.3.18",
    "sharp": "^0.35.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
