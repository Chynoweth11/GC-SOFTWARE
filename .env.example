# Optional. Both the app and the Prisma CLI fall back to this exact value, so a
# local checkout needs no .env at all: copy this file only if you want to point
# somewhere else.
#
# The path is resolved from the project root, not from prisma/.
DATABASE_URL="file:./prisma/dev.db"

# To move to Postgres, change the provider in prisma/schema.prisma to
# postgresql, swap the adapter in src/lib/db.ts, and set a connection string:
# DATABASE_URL="postgresql://user:password@localhost:5432/constructx"

# Only needed when the app is served through a proxy or a different domain than
# it is bound to: Next rejects a Server Action whose Origin disagrees with the
# Host. Comma-separated; wildcards allowed. Cloud development hosts (Codespaces,
# Gitpod, ngrok and friends) are already trusted in development.
# ALLOWED_ORIGINS="constructx.example.com,*.example.com"
