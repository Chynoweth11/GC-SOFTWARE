# Optional. Both the app and the Prisma CLI fall back to this exact value, so a
# local checkout needs no .env at all: copy this file only if you want to point
# somewhere else.
#
# The path is resolved from the project root, not from prisma/.
DATABASE_URL="file:./prisma/dev.db"

# To move to Postgres, change the provider in prisma/schema.prisma to
# postgresql, swap the adapter in src/lib/db.ts, and set a connection string:
# DATABASE_URL="postgresql://user:password@localhost:5432/constructx"

# Only needed when the app is served through a proxy or a different domain than
# it is bound to: Next rejects a Server Action whose Origin disagrees with the
# Host. Comma-separated; wildcards allowed. Cloud development hosts (Codespaces,
# Gitpod, ngrok and friends) are already trusted in development.
# ALLOWED_ORIGINS="constructx.example.com,*.example.com"

# ─────────────────────────────────────────────────────────────
# Where this deployment lives. Needed by single sign-on, which has to tell the
# identity provider where to send people back to, and used in the link at the
# bottom of an email.
# APP_URL="https://constructx.yourgc.com"

# ─────────────────────────────────────────────────────────────
# Signing in through the directory the company already runs.
#
# Leave SSO_PROVIDER unset for password sign-in only. Signing in this way never
# creates an account: somebody has to exist here first, with a role chosen
# deliberately, because the role is the whole of what they may see.
#
# Register the application with the provider and set the callback to
# <APP_URL>/api/auth/sso/callback
#
#   GitHub     Settings, Developer settings, OAuth Apps
#   Google     Cloud console, APIs and services, Credentials, OAuth client ID
#   Microsoft  Entra admin centre, App registrations
#
# SSO_PROVIDER="google"              # github | google | microsoft
# SSO_CLIENT_ID=""
# SSO_CLIENT_SECRET=""
# SSO_ALLOWED_DOMAINS="yourgc.com"   # optional; blank allows any domain
# SSO_TENANT="common"                # Microsoft only

# ─────────────────────────────────────────────────────────────
# Sending mail, for the compliance reminders.
#
# Deliverability is somebody else's problem on purpose: SPF, DKIM, DMARC and a
# sending reputation are not things a contractor's financial system should own.
# With nothing set here, deadlines still reach people through the dashboard and
# the calendar feed at /api/calendar/compliance.ics, and the settings page says
# plainly that email is switched off.
#
# MAIL_PROVIDER="resend"                       # resend | smtp
# MAIL_FROM="ConstructX <alerts@yourgc.com>"
# MAIL_REPLY_TO=""
# RESEND_API_KEY=""                            # when MAIL_PROVIDER=resend
# SMTP_URL="smtps://user:pass@smtp.host:465"   # when MAIL_PROVIDER=smtp
#                                              # also run: npm install nodemailer

# ─────────────────────────────────────────────────────────────
# The daily compliance digest.
#
# Point any scheduler at <APP_URL>/api/cron/compliance-digest with an
# Authorization: Bearer header carrying this secret. Without it the endpoint
# refuses every call. Nothing is sent on a day when nothing is overdue or due
# soon, so a message arriving always means there is something to do.
#
#   0 13 * * 1-5  curl -fsS -H "Authorization: Bearer $CRON_SECRET" \
#                   https://constructx.yourgc.com/api/cron/compliance-digest
#
# CRON_SECRET=""

# ─────────────────────────────────────────────────────────────
# Where attached financial records are kept.
#
# A signed change order is the evidence behind an approval. It is stored, hashed
# with SHA-256 on the way in, and checked again on every download, so it can be
# produced in a year and proved to be the file that was approved.
#
# The default writes to a directory on the server, which is fine for one machine
# with a real backup behind it. Anything with more than one machine, or without
# a backup you trust, should use object storage.
#
# FILE_STORAGE="local"
# FILE_STORAGE_DIR="./var/uploads"
#
# Any S3-compatible service works: AWS S3, Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces, MinIO. Requests are signed directly, so there is no SDK
# to keep up to date.
#
# FILE_STORAGE="s3"
# S3_BUCKET=""
# S3_REGION="auto"
# S3_ENDPOINT=""               # leave blank for AWS itself
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# ─────────────────────────────────────────────────────────────
# Moving to Postgres.
#
# SQLite is the default and is genuinely enough for one office on one machine
# with a real backup behind it. Postgres is what a company with more than one
# person saving at a time should be on: SQLite takes one writer at a time, so
# two project managers pressing save together queue behind each other.
#
# The schema is written once, in prisma/schema.prisma. The Postgres copy is
# generated from it, so the two cannot drift:
#
#   npm run db:postgres-schema
#   DATABASE_URL="postgresql://user:pass@host:5432/constructx" npx prisma generate
#   DATABASE_URL="postgresql://user:pass@host:5432/constructx" npx prisma migrate deploy
#   DATABASE_URL="postgresql://user:pass@host:5432/constructx" npx tsx prisma/seed.ts
#
# The generated client is baked to one engine, so it is regenerated when the
# connection string disagrees with it. `npm run dev` does that for you.
#
# DATABASE_URL="postgresql://constructx:password@localhost:5432/constructx"

# When FILE_STORAGE=local in production, the directory must be named and must be
# absolute. There is no default: writing signed contracts into whatever
# directory the process happened to start in, and which may not be backed up, is
# how a company loses them. In development it falls back to ./var/uploads.
# FILE_STORAGE_DIR="/srv/constructx/uploads"
